@model Habitacion
@{ViewData["Title"]="Detalle de habitación";}
<div class="eyebrow">ALOJAMIENTO</div><h1 class="form-title">Habitación @Model.Numero</h1><div class="surface confirm-box"><dl class="detail-list"><dt>Tipo</dt><dd>@Model.IdTipoHabitacionNavigation.Nombre</dd><dt>Piso</dt><dd>@Model.Piso</dd><dt>Capacidad</dt><dd>@Model.IdTipoHabitacionNavigation.Capacidad personas</dd><dt>Precio por noche</dt><dd>S/ @Model.IdTipoHabitacionNavigation.PrecioNoche.ToString("N2")</dd></dl><a class="btn-primary" asp-action="Index">Volver a habitaciones</a></div>
