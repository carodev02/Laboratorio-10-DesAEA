@model Habitacion
@{ViewData["Title"]="Dar de baja habitación";}
<div class="eyebrow">ALOJAMIENTO</div><h1 class="form-title">Dar de baja la habitación</h1><div class="surface confirm-box"><p>¿Deseas dar de baja la habitación <strong>@Model.Numero</strong>?</p><p class="info-line">La habitación dejará de aparecer en las opciones disponibles.</p><form asp-action="Delete"><input type="hidden" asp-for="IdHabitacion"/><div class="form-actions"><button class="btn-primary" type="submit">Confirmar baja</button><a class="btn-secondary-soft" asp-action="Index">Volver</a></div></form></div>
