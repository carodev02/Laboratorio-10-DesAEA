@model IEnumerable<Habitacion>
@{ ViewData["Title"] = "Habitaciones"; }
<div class="page-head"><div><div class="eyebrow">ALOJAMIENTO</div><h1>Habitaciones</h1><p>Espacios disponibles para cada tipo de estancia.</p></div><a class="btn-primary" asp-action="Create">＋ Nueva habitación</a></div>
<form method="get" class="surface toolbar"><div class="field"><label for="tipoId">Tipo de habitación</label><select class="form-select" id="tipoId" name="tipoId" asp-items="ViewBag.Tipos"><option value="">Todos los tipos</option></select></div><button class="btn-primary" type="submit">Filtrar</button><a class="btn-secondary-soft" asp-action="Index">Limpiar</a></form>
<div class="surface table-wrap"><table class="table"><thead><tr><th>Habitación</th><th>Tipo</th><th>Piso</th><th>Capacidad</th><th>Precio por noche</th><th></th></tr></thead><tbody>
@if (!Model.Any()){<tr><td colspan="6" class="empty">No hay habitaciones que coincidan con este filtro.</td></tr>}else{@foreach(var h in Model){<tr><td><span class="room-number">N.° @h.Numero</span></td><td><span class="badge-soft">@h.IdTipoHabitacionNavigation.Nombre</span></td><td>@h.Piso</td><td>@h.IdTipoHabitacionNavigation.Capacidad personas</td><td class="price">S/ @h.IdTipoHabitacionNavigation.PrecioNoche.ToString("N2")</td><td><div class="actions"><a class="action-link" asp-action="Details" asp-route-id="@h.IdHabitacion">Ver</a><a class="action-link" asp-action="Edit" asp-route-id="@h.IdHabitacion">Editar</a><a class="action-link" asp-action="Delete" asp-route-id="@h.IdHabitacion">Dar de baja</a></div></td></tr>}}</tbody></table></div>
