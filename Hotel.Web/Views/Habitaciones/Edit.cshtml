@model Habitacion
@{ViewData["Title"]="Editar habitación";}
<div class="eyebrow">ALOJAMIENTO</div><h1 class="form-title">Editar habitación @Model.Numero</h1><div class="surface form-card"><form asp-action="Edit"><input type="hidden" asp-for="IdHabitacion"/><partial name="_Form" model="Model"/><div class="form-actions"><button class="btn-primary" type="submit">Guardar cambios</button><a class="btn-secondary-soft" asp-action="Index">Cancelar</a></div></form></div>
@section Scripts {<partial name="_ValidationScriptsPartial"/>}
