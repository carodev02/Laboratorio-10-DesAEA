@model IEnumerable<HabitacionDisponible>
@{ViewData["Title"]="Disponibilidad";}
<div class="page-head"><div><div class="eyebrow">PLANIFICA TU ESTANCIA</div><h1>Disponibilidad</h1><p>Encuentra una habitación para las fechas elegidas.</p></div></div>
<form method="get" class="surface toolbar"><div class="filter-form"><div class="field"><label for="ingreso">Fecha de ingreso</label><input class="form-control" id="ingreso" name="ingreso" type="date" value="@ViewBag.Ingreso" required/></div><div class="field"><label for="salida">Fecha de salida</label><input class="form-control" id="salida" name="salida" type="date" value="@ViewBag.Salida" required/></div><button class="btn-primary" type="submit">Buscar habitaciones</button></div></form>
@if(ViewBag.Ingreso is string i && ViewBag.Salida is string s && DateTime.TryParse(i,out _) && DateTime.TryParse(s,out _) && DateTime.Parse(s)<=DateTime.Parse(i)){<div class="text-danger mb-3">La salida debe ser posterior al ingreso.</div>}
<div class="surface table-wrap"><table class="table"><thead><tr><th>Habitación</th><th>Tipo</th><th>Capacidad</th><th>Noches</th><th>Total estimado</th><th></th></tr></thead><tbody>
@if(!Model.Any()){<tr><td colspan="6" class="empty">Elige las fechas para consultar habitaciones disponibles.</td></tr>}else{@foreach(var item in Model){<tr><td><span class="room-number">N.° @item.Habitacion.Numero</span><div class="subtle">Piso @item.Habitacion.Piso</div></td><td><span class="badge-soft">@item.Habitacion.IdTipoHabitacionNavigation.Nombre</span></td><td>@item.Habitacion.IdTipoHabitacionNavigation.Capacidad</td><td>@item.Noches</td><td><span class="price">S/ @item.Total.ToString("N2")</span></td><td><a class="action-link" asp-action="Create" asp-route-ingreso="@ViewBag.Ingreso" asp-route-salida="@ViewBag.Salida">Reservar ↗</a></td></tr>}}</tbody></table></div>
