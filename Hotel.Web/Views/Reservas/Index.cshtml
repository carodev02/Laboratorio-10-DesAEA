@model IEnumerable<Reserva>
@{ViewData["Title"]="Reservas";}
<div class="page-head"><div><div class="eyebrow">ESTANCIAS</div><h1>Reservas</h1><p>Consulta el estado y los detalles de cada reserva.</p></div><a class="btn-primary" asp-action="Create">＋ Nueva reserva</a></div>
<div class="surface table-wrap"><table class="table"><thead><tr><th>Huésped</th><th>Habitación</th><th>Estancia</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody>
@if(!Model.Any()){<tr><td colspan="6" class="empty">Aún no hay reservas registradas.</td></tr>}else{@foreach(var r in Model){var noches=r.FechaSalida.DayNumber-r.FechaIngreso.DayNumber;var total=noches*r.IdHabitacionNavigation.IdTipoHabitacionNavigation.PrecioNoche;<tr><td><span class="room-number">@r.IdHuespedNavigation.Apellidos, @r.IdHuespedNavigation.Nombres</span><div class="subtle">DNI @r.IdHuespedNavigation.Dni</div></td><td>@r.IdHabitacionNavigation.Numero <div class="subtle">@r.IdHabitacionNavigation.IdTipoHabitacionNavigation.Nombre</div></td><td>@r.FechaIngreso.ToString("dd MMM yyyy")<div class="subtle">hasta @r.FechaSalida.ToString("dd MMM yyyy") · @noches noches</div></td><td><span class="badge-status status-@r.Estado.ToLowerInvariant()">@r.Estado</span></td><td class="price">S/ @total.ToString("N2")</td><td>@if(r.Estado is "Pendiente" or "Confirmada"){<form asp-action="Cancelar" asp-route-id="@r.IdReserva" method="post"><button class="action-link border-0 bg-transparent p-0" type="submit">Cancelar</button></form>}</td></tr>}}</tbody></table></div>
